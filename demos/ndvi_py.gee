# py
"""
Amazon Deforestation & Gold Mining Analysis — La Pampa, Madre de Dios (Peru)
GEE Pro IDE — Multi-spectral Sentinel-2 + NDVI monitoring
"""
import ee

# 0. Limpiar capas previas en el visor
Map.clear()

# 1. Zona de estudio: La Pampa, Madre de Dios (Epicentro de minería aluvial en la Amazonía)
# Coordenadas: -12.85°S, -69.85°W con un radio de 6 km
roi = ee.Geometry.Point([-69.85, -12.85]).buffer(6000)

# 2. Centrar automáticamente el mapa en la zona de estudio (zoom 13)
Map.centerObject(roi, 13)

# 3. Filtrar colección Sentinel-2 Harmonized (Época seca 2023 para mínima nubosidad)
s2_scene = (ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(roi)
  .filterDate('2023-05-01', '2023-11-30')
  .sort('CLOUDY_PIXEL_PERCENTAGE')
  .first())

# Imagen recortada al ROI
image = s2_scene.clip(roi)

# 4. Calcular NDVI: (NIR - RED) / (NIR + RED)
ndvi = image.normalizedDifference(['B8', 'B4']).rename('NDVI')

# 5. Parámetros de visualización

# Color Natural: B4 (Rojo), B3 (Verde), B2 (Azul)
rgbVis = {
  'bands': ['B4', 'B3', 'B2'],
  'min': 0,
  'max': 2800
}

# Falso Color Geológico / SWIR: B12 (SWIR-2), B8 (NIR), B4 (Rojo)
# Destaca pozos mineros con agua turbia/sedimentos, relaves de arena y frentes de deforestación
swirVis = {
  'bands': ['B12', 'B8', 'B4'],
  'min': 0,
  'max': 3500
}

# Gradiente NDVI:
# Rojo/Naranja: Suelo desnudo, pozos mineros y deforestación
# Amarillo: Vegetación secundaria / arbustiva
# Verde oscuro: Dosel de selva amazónica primaria densa
ndviVis = {
  'min': -0.1,
  'max': 0.85,
  'palette': ['#d73027', '#f46d43', '#fdae61', '#fee08b', '#d9ef8b', '#a6d96a', '#1a9850', '#006837']
}

# 6. Proyectar capas al visor interactivo de GEE Pro
# Capa 1: Color Natural enfocado en La Pampa
Map.addLayer(image, rgbVis, '1. Sentinel-2 Color Natural (La Pampa)', True, 1.0)

# Capa 2: SWIR Minería y Pozos Mineros (Falso Color)
Map.addLayer(image, swirVis, '2. SWIR Minería y Agua Turbia (Falso Color)', False, 1.0)

# Capa 3: NDVI Cobertura y Pérdida Forestal
Map.addLayer(ndvi, ndviVis, '3. NDVI Salud Vegetal vs Minería', True, 0.85)

# Capa 4: Contorno rojo del Área de Estudio (ROI)
Map.addLayer(roi, {'color': 'FF0000', 'width': 2}, '📍 Límite ROI La Pampa (6 km)', True, 1.0)

print("✅ Análisis amazónico completado exitosamente en Python.")
print("📍 Ubicación: La Pampa, Madre de Dios, Perú (-12.85°S, -69.85°W)")
print("🛰️ Capas disponibles en el control de capas (arriba a la derecha del mapa):")
print("   • Sentinel-2 Color Natural (La Pampa)")
print("   • SWIR Minería y Agua Turbia (Falso Color)")
print("   • NDVI Salud Vegetal vs Minería (Rojo = Deforestación, Verde = Selva)")
print("   • Límite ROI La Pampa (Contorno Rojo)")
