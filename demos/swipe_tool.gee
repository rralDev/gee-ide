// js
// ==============================================================================
// 🌍 GEE IDE: Demostración de Swipe Tool (Comparador Antes / Después)
// ==============================================================================
// Este script compara el Índice de Vegetación (NDVI) entre dos años para
// evidenciar la pérdida de bosque en La Pampa, Madre de Dios (Perú).

// 0. Limpiar capas previas
Map.clear();

var roi = ee.Geometry.Point([-69.08924, -12.08565]).buffer(6000);
Map.centerObject(roi, 13);

// Colección Sentinel-2
var s2 = ee.ImageCollection("COPERNICUS/S2_SR_HARMONIZED")
  .filterBounds(roi)
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 15));

// Función para calcular NDVI
function addNDVI(image) {
  var ndvi = image.normalizedDifference(['B8', 'B4']).rename('NDVI');
  return image.addBands(ndvi);
}

// 1. NDVI del "Antes" (Año 2019)
var img2019 = s2.filterDate('2019-01-01', '2019-12-31').map(addNDVI).median().clip(roi);

// 2. NDVI del "Después" (Año 2024)
var img2024 = s2.filterDate('2023-01-01', '2024-01-01').map(addNDVI).median().clip(roi);

// Parámetros de visualización para NDVI (Azul = Agua, Amarillo/Ocre = Deforestación, Verde = Bosque)
var ndviVis = {
  bands: ['NDVI'],
  min: -0.2,
  max: 0.85,
  palette: [
    '#0c0c78', '#80b1d3', '#ffffff', '#ce7e45', '#df923d', 
    '#fcd163', '#99b718', '#66a000', '#3e8601', '#056201', '#004c00'
  ]
};

// 3. Agregar capas al mapa (Agrega la antigua primero, la nueva encima)
Map.addLayer(img2019, ndviVis, '1. NDVI (2019) - Antes');
Map.addLayer(img2024, ndviVis, '2. NDVI (2024) - Después');

print("✅ Capas NDVI cargadas exitosamente.");
print("Haz clic en el botón 🔀 (Swipe Tool) en el visor de mapas.");
print("💡 Observa cómo las zonas verdes (bosque sano) se vuelven amarillas/rojas (deforestación).");
